    "import math\n",
    "\n",
    "# Сигмоидная функция для выдачи результата 0-1\n",
    "def sigmoidFn(value):\n",
    "\treturn 1 / (1 + math.exp(-value))\n",
    "\n",
    "print(sigmoidFn(0.30))\n"
   ]
  },
